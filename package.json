{
  "name": "slides",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "node scripts/dev-talk.mjs",
    "dev:landing": "node scripts/dev-landing.mjs",
    "build": "node scripts/build-all.mjs",
    "preview": "vite preview --root landing --outDir ../dist",
    "scan": "node scripts/scan-talks.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p landing/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@iconify-json/mdi": "^1.2.3",
    "@slidev/cli": "^52.14.2",
    "@slidev/theme-default": "^0.25.0",
    "@types/node": "^25.6.0",
    "@unocss/preset-attributify": "^66.6.8",
    "@unocss/preset-icons": "^66.6.8",
    "@unocss/preset-uno": "^66.6.8",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/ui": "^4.1.5",
    "chokidar": "^5.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-format": "^2.0.1",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "playwright": "^1.59.1",
    "playwright-chromium": "^1.59.1",
    "prettier-plugin-slidev": "^1.0.5",
    "typescript": "^6.0.3",
    "unocss": "^66.6.8",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "vue": "^3.5.33",
    "vue-tsc": "^3.2.7",
    "zx": "^8.8.5"
  }
}
